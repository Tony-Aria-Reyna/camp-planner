rules_version = '2';
// NZ Camp Planner — live shared trips.
// Only the Google accounts in a trip's "members" can read or change it. Anyone signed in who has the invite link
// (it contains the trip's long random id) can add themselves while the organiser leaves "anyone with the link can join" on.
// Written so later versions of the planner can add new fields and new lists without changing these rules:
//  - a trip document may hold any other fields (only owner, members and open are guarded);
//  - anything stored under a trip (trips/{id}/<anything>/...) follows that trip's membership;
//  - each person has their own users/{email} area for settings and future features;
//  - config/{doc} holds app-wide settings that only the admin can change.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && email() == 'tonyandreynanz@gmail.com'; }
    function okTrip(d) { return d.members is list && d.members.size() >= 1 && d.members.size() <= 50
                         && (!('data' in d) || (d.data is string && d.data.size() < 1000000)); }
    function memberOf(id) { return signedIn() && email() in get(/databases/$(database)/documents/trips/$(id)).data.members; }

    match /trips/{id} {
      allow read: if signedIn() && email() in resource.data.members;
      allow create: if signedIn() && okTrip(request.resource.data)
                    && request.resource.data.owner == email() && request.resource.data.members == [email()];
      allow update: if signedIn() && okTrip(request.resource.data) && request.resource.data.owner == resource.data.owner && (
          // a member: change anything in the trip; only the organiser removes other people or closes the invite; anyone can leave
          (email() in resource.data.members
             && request.resource.data.owner in request.resource.data.members
             && (request.resource.data.members.hasAll(resource.data.members)
                 || email() == resource.data.owner
                 || request.resource.data.members.toSet() == resource.data.members.toSet().difference([email()].toSet()))
             && (request.resource.data.get('open', true) == resource.data.get('open', true) || email() == resource.data.owner))
          // someone with the invite link joining: they may only add themselves
          || (!(email() in resource.data.members) && resource.data.get('open', true) == true
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
             && request.resource.data.members.toSet() == resource.data.members.toSet().union([email()].toSet()))
        );
      allow delete: if signedIn() && email() == resource.data.owner;

      // future lists inside a trip (comments, photos, chat, packing claims…) — the trip's crew can use them
      match /{col}/{doc=**} {
        allow read, write: if memberOf(id);
      }
    }

    // each person's own settings and future per-person features
    match /users/{userEmail}/{doc=**} {
      allow read, write: if signedIn() && email() == userEmail.lower();
    }

    // app-wide settings (e.g. notices to every user): everyone signed in reads, only the admin writes
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
